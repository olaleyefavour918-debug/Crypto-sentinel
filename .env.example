# ─────────────────────────────────────────────────────────────────────────────
# BTC Sentinel — environment variables
# Copy to .env.local for local development. On Vercel, add them in
# Project → Settings → Environment Variables. NEVER commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# 1) DATABASE (required) ─ Postgres connection string.
#    On Vercel: Storage → Create Database → Neon (Postgres) → Connect to project.
#    Vercel then injects DATABASE_URL (and POSTGRES_URL) automatically — you type nothing.
DATABASE_URL=

# 2) DASHBOARD PASSWORD (required) ─ you choose it; 12+ characters recommended.
#    There is intentionally NO default password.
ADMIN_PASSWORD=

# 3) SCHEDULER SECRET (required for monitoring) ─ any long random string (32+ chars).
#    Vercel Cron sends it automatically as "Authorization: Bearer <value>".
#    External schedulers (cron-job.org, GitHub Actions) must send the same header.
#    Generate one:  openssl rand -hex 32
CRON_SECRET=

# 4) EMAIL (required to actually receive alerts) ─ pick ONE way.
#    Option 0 — Built-in SMTP (no third-party service). Easiest: send from your own Gmail.
#    Turn on 2-Step Verification, then create an App Password at https://myaccount.google.com/apppasswords
#    (a separate 16-character code — NEVER your normal Gmail password). If set, this wins over Resend/Brevo.
SMTP_USER=
SMTP_PASS=
#    SMTP_HOST=smtp.gmail.com   (default)   SMTP_PORT=465 (default, implicit TLS)
#    Option A — Resend (https://resend.com). Sign up WITH olaleyevictor206@gmail.com;
#    its free test sender can then deliver to that address with no domain setup.
RESEND_API_KEY=
#    Option B — Brevo (https://www.brevo.com). Verify a single sender address, no domain needed.
BREVO_API_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# Sender shown on alerts. Defaults: Resend → "BTC Sentinel <onboarding@resend.dev>".
# For Brevo you MUST set this to your verified sender, e.g. "BTC Sentinel <you@gmail.com>".
EMAIL_FROM=
# Resend webhook signing secret (whsec_...) — enables "delivered"/"bounced" confirmation.
RESEND_WEBHOOK_SECRET=
# Separate secret for signing login cookies. If empty, one is derived from ADMIN_PASSWORD.
SESSION_SECRET=
# Override the Bybit host (e.g. https://api.bytick.com) if the default is blocked in your region.
BYBIT_BASE_URL=
